{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/index.html"
    },
    {
      "source": "/services/:category",
      "destination": "/index.html"
    },
    {
      "source": "/services/:category/:service",
      "destination": "/index.html"
    },
    {
      "source": "/industries",
      "destination": "/index.html"
    },
    {
      "source": "/industries/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/projects",
      "destination": "/index.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/resources",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/careers",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/locations",
      "destination": "/index.html"
    },
    {
      "source": "/locations/:slug",
      "destination": "/index.html"
    }
  ]
}
